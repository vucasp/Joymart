@* =====================================================================
   VIEW: Views/Orders/Details.cshtml
   MỤC ĐÍCH:
     Hiển thị thông tin chi tiết đơn hàng cho Admin (gồm ngày đặt, ngày xuất hàng,
     ngày hoàn thành, phí vận chuyển, tổng thanh toán và danh sách sản phẩm).
   ===================================================================== *@
@model Joymart.Models.OrderPro
@using System.Linq

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    decimal subTotal = Model.OrderDetails.Sum(d => d.Quantity * d.UnitPrice);
}

<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 class="section-title">Chi tiết đơn hàng #@Model.OrderID</h2>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            @if (Model.Status == "Chờ xử lý" || Model.Status == "Đã xác nhận")
            {
                @Html.ActionLink("Chuyển sang Xuất hàng / Giao hàng", "Dispatch", "Orders", new { id = Model.OrderID }, new { @class = "btn-brand" })
            }
            @Html.ActionLink("← Quay lại danh sách đơn", "Index", "Orders", null, new { @class = "btn-soft" })
        </div>
    </div>

    @if (TempData["OrderSuccessMsg"] != null)
    {
        <div class="cart-message cart-message-success">@TempData["OrderSuccessMsg"]</div>
    }
    @if (TempData["OrderErrorMsg"] != null)
    {
        <div class="cart-message cart-message-error">@TempData["OrderErrorMsg"]</div>
    }

    <!-- THÔNG TIN ĐƠN HÀNG & THÔNG TIN GIAO HÀNG -->
    <div class="order-info-grid">
        <div class="order-info-card">
            <h3>Thông tin vận hành đơn hàng</h3>
            <p><strong>Mã đơn:</strong> #@Model.OrderID</p>
            <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Ngày xuất hàng:</strong> @(Model.ShippedDate.HasValue ? Model.ShippedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa xuất kho")</p>
            <p><strong>Ngày hoàn thành:</strong> @(Model.CompletedDate.HasValue ? Model.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa hoàn thành")</p>
            <p>
                <strong>Trạng thái hiện tại:</strong>
                <span class="status-badge @(Model.Status == "Hoàn thành" ? "status-active" : (Model.Status == "Đã hủy" ? "status-inactive" : (Model.Status == "Đang giao" ? "status-info" : "status-warning")))">
                    @Model.Status
                </span>
            </p>
            <p><strong>Tiền hàng tạm tính:</strong> @subTotal.ToString("#,##0") đ</p>
            <p><strong>Phí vận chuyển:</strong> @(Model.ShippingFee == 0 ? "Miễn phí (0 đ)" : Model.ShippingFee.ToString("#,##0") + " đ")</p>
            <p><strong>Tổng thanh toán:</strong> <span class="product-price">@Model.TotalAmount.ToString("#,##0") đ</span></p>
        </div>

        <div class="order-info-card">
            <h3>Thông tin người nhận hàng</h3>
            <p><strong>Người nhận:</strong> @(Model.RecipientName ?? (Model.Customer != null ? Model.Customer.FullName : ""))</p>
            <p><strong>Số điện thoại:</strong> @(Model.ShippingPhone ?? (Model.Customer != null ? Model.Customer.Phone : ""))</p>
            <p><strong>Email:</strong> @(Model.Customer != null ? Model.Customer.Email : "")</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        </div>
    </div>

    <h3 style="margin-bottom: 14px; font-weight: 800; font-size: 18px;">Danh sách sản phẩm đặt mua (@Model.OrderDetails.Sum(d => d.Quantity) sản phẩm)</h3>
    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="~/Content/images/@(string.IsNullOrEmpty(detail.Product.ImageUrl) ? "no-image.png" : detail.Product.ImageUrl)"
                                     alt="@detail.Product.ProductName"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                                <strong>@detail.Product.ProductName</strong>
                            </div>
                        </td>
                        <td>@detail.UnitPrice.ToString("#,##0") đ</td>
                        <td><strong>@detail.Quantity</strong></td>
                        <td class="product-price">@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
