@model Joymart.Models.OrderPro
@using System.Linq

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    string[] statuses = { "Chờ xử lý", "Đã xác nhận", "Đang giao", "Hoàn thành", "Đã hủy" };
}

<div class="order-success">
    <div class="admin-toolbar">
        <h2 class="section-title">Chi tiết đơn hàng #@Model.OrderID</h2>
        @Html.ActionLink("← Quay lại danh sách đơn", "Index", "Orders", null, new { @class = "btn-soft" })
    </div>

    @if (TempData["OrderSuccessMsg"] != null)
    {
        <div class="cart-message cart-message-success">
            @TempData["OrderSuccessMsg"]
        </div>
    }

    <!-- Khối cập nhật trạng thái đơn hàng -->
    <div class="admin-panel" style="margin-top: 0; margin-bottom: 22px; padding: 18px 24px;">
        @using (Html.BeginForm("UpdateStatus", "Orders", FormMethod.Post, new { style = "display:flex; align-items:center; gap:14px; flex-wrap:wrap;" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.OrderID" />
            <label for="status" style="font-weight: 700; margin: 0;">Cập nhật trạng thái đơn:</label>

            <select id="status" name="status" class="form-control-modern" style="max-width: 240px;">
                @foreach (var st in statuses)
                {
                    <option value="@st" @(Model.Status == st ? "selected" : "")>@st</option>
                }
            </select>

            <button type="submit" class="btn-brand">Lưu trạng thái</button>
        }
    </div>

    <!-- Thông tin đơn hàng & Thông tin giao hàng -->
    <div class="order-info-grid">
        <div class="order-info-card">
            <h3>Thông tin đơn hàng</h3>
            <p><strong>Mã đơn:</strong> #@Model.OrderID</p>
            <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Trạng thái hiện tại:</strong> <span class="product-category-tag" style="margin:0;">@Model.Status</span></p>
            <p><strong>Tổng số lượng:</strong> @Model.OrderDetails.Sum(d => d.Quantity) sản phẩm</p>
            <p><strong>Tổng tiền:</strong> <span class="product-price">@Model.TotalAmount.ToString("#,##0") đ</span></p>
        </div>

        <div class="order-info-card">
            <h3>Thông tin giao hàng</h3>
            <p><strong>Người nhận:</strong> @(Model.RecipientName ?? (Model.Customer != null ? Model.Customer.FullName : ""))</p>
            <p><strong>Số điện thoại:</strong> @(Model.ShippingPhone ?? (Model.Customer != null ? Model.Customer.Phone : ""))</p>
            <p><strong>Email:</strong> @(Model.Customer != null ? Model.Customer.Email : "")</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        </div>
    </div>

    <!-- Danh sách sản phẩm trong đơn -->
    <h3 style="margin-bottom: 14px; font-weight: 800;">Danh sách sản phẩm đặt mua</h3>
    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="~/Content/images/@(string.IsNullOrEmpty(detail.Product.ImageUrl) ? "no-image.png" : detail.Product.ImageUrl)" alt="@detail.Product.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                                <strong>@detail.Product.ProductName</strong>
                            </div>
                        </td>
                        <td>@detail.UnitPrice.ToString("#,##0") đ</td>
                        <td><strong>@detail.Quantity</strong></td>
                        <td class="product-price">@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>