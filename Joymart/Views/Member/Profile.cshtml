@* =====================================================================
   VIEW: Views/Member/Profile.cshtml
   MỤC ĐÍCH:
     Trang Cập nhật hồ sơ khách hàng:
       - Phần tiêu đề phía trên căn giữa toàn bộ (auth-card-header).
       - Từ phần Tên đăng nhập trở xuống giữ căn lề trái chuẩn form nhập liệu.
   ===================================================================== *@
@model Joymart.Models.ProfileViewModel

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-card" style="max-width: 560px;">
        <!-- Phần tiêu đề phía trên căn giữa toàn bộ -->
        <div class="auth-card-header">
            <span class="product-category-tag" style="align-self: center;">TÀI KHOẢN CỦA TÔI</span>
            <h2>Cập nhật hồ sơ</h2>
            <p class="auth-subtitle" style="margin-bottom: 12px;">Thông tin này sẽ được tự động điền khi bạn đặt hàng tại Joymart.</p>
            <div style="margin-bottom: 20px;">
                @Html.ActionLink("Đổi mật khẩu tài khoản", "ChangePassword", "Member", null, new { @class = "btn-soft", style = "padding: 6px 14px; font-size: 13px;" })
            </div>
        </div>

        @if (TempData["MemberSuccess"] != null)
        {
            <div class="cart-message cart-message-success" style="text-align: center;">@TempData["MemberSuccess"]</div>
        }

        <!-- Từ phần Tên đăng nhập trở xuống căn lề trái -->
        <div class="auth-form-body">
            @using (Html.BeginForm("Profile", "Member", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

                <div class="auth-field">
                    @Html.LabelFor(m => m.UserName)
                    <input type="text" class="form-control-modern" value="@Model.UserName" disabled style="background: #f1f5f9; color: #64748b;" />
                </div>

                <div class="auth-field">
                    @Html.LabelFor(m => m.FullName)
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control-modern", placeholder = "Tối đa 20 ký tự (ví dụ: Nguyễn Văn A)", maxlength = "20" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>

                <div class="auth-field">
                    @Html.LabelFor(m => m.Phone)
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control-modern", placeholder = "10 chữ số bắt đầu bằng 0 (ví dụ: 0901234567)", maxlength = "10" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                </div>

                <div class="auth-field">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control-modern", placeholder = "Bắt buộc đuôi @gmail.com (ví dụ: example@gmail.com)" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="auth-field">
                    @Html.LabelFor(m => m.Address)
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control-modern", placeholder = "Địa chỉ nhận hàng mặc định" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-brand auth-submit">Lưu thay đổi hồ sơ</button>
            }
        </div>
    </div>
</div>
