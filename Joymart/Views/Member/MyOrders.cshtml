@model IEnumerable<Joymart.Models.OrderPro>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 class="section-title">Lịch sử đơn hàng của tôi</h2>
        @Html.ActionLink("← Tiếp tục mua sắm", "Index", "Store", null, new { @class = "btn-soft" })
    </div>

    @if (TempData["MemberSuccess"] != null)
    {
        <div class="cart-message cart-message-success">@TempData["MemberSuccess"]</div>
    }
    @if (TempData["MemberError"] != null)
    {
        <div class="cart-message cart-message-error">@TempData["MemberError"]</div>
    }

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 36px 16px;">
            <p style="color: var(--muted); margin-bottom: 16px;">Bạn chưa có đơn hàng nào tại Joymart.</p>
            @Html.ActionLink("Khám phá sản phẩm ngay", "Index", "Store", null, new { @class = "btn-brand" })
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Người nhận</th>
                        <th>Địa chỉ giao hàng</th>
                        <th>Tổng thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.OrderID</strong></td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.RecipientName</td>
                            <td style="max-width: 240px;">@item.ShippingAddress</td>
                            <td><strong style="color: #e11d48;">@item.TotalAmount.ToString("#,##0") đ</strong></td>
                            <td>
                                <span class="status-badge @(item.Status == "Hoàn thành" ? "status-active" : (item.Status == "Đã hủy" ? "status-inactive" : ""))"
                                      style="@(item.Status != "Hoàn thành" && item.Status != "Đã hủy" ? "background:#fef3c7; color:#b45309;" : "")">
                                    @item.Status
                                </span>
                            </td>
                            <td style="display: flex; gap: 8px; flex-wrap: wrap;">
                                @Html.ActionLink("Chi tiết", "OrderDetails", new { id = item.OrderID }, new { @class = "btn-soft", style = "padding: 6px 12px; font-size: 13px;" })

                                @if (item.Status == "Chờ xử lý")
                                {
                                    using (Html.BeginForm("CancelOrder", "Member", FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Bạn có chắc muốn hủy đơn hàng #" + item.OrderID + " không?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@item.OrderID" />
                                        <button type="submit" class="nav-link-button" style="padding: 5px 12px; font-size: 13px;">Hủy đơn</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>