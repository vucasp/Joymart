@model Joymart.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = Convert.ToString(Session["Role"]) == "Admin"
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <span class="product-category-tag">BẢO MẬT TÀI KHOẢN</span>
        <h2>Đổi mật khẩu</h2>
        <p class="auth-subtitle">Nhập mật khẩu hiện tại và đặt mật khẩu mới tối thiểu 6 ký tự.</p>

        @if (TempData["MemberSuccess"] != null)
        {
            <div class="cart-message cart-message-success">@TempData["MemberSuccess"]</div>
        }

        @using (Html.BeginForm("ChangePassword", "Member", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

            <div class="auth-field">
                @Html.LabelFor(m => m.OldPassword)
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control-modern", placeholder = "Nhập mật khẩu đang dùng" })
                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
            </div>

            <div class="auth-field">
                @Html.LabelFor(m => m.NewPassword)
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control-modern", placeholder = "Ít nhất 6 ký tự" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <div class="auth-field">
                @Html.LabelFor(m => m.ConfirmNewPassword)
                @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control-modern", placeholder = "Nhập lại mật khẩu mới" })
                @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-brand auth-submit">Cập nhật mật khẩu</button>
        }

        <p class="auth-bottom-link">
            @if (Session["CustomerID"] != null)
            {
                <a href="@Url.Action("Profile", "Member")" style="color: var(--brand-dark); font-weight: 700;">← Quay lại hồ sơ cá nhân</a>
            }
            else if (Convert.ToString(Session["Role"]) == "Admin")
            {
                <a href="@Url.Action("Index", "Admin")" style="color: var(--brand-dark); font-weight: 700;">← Quay lại bảng quản trị</a>
            }
            else
            {
                <a href="@Url.Action("Index", "Store")" style="color: var(--brand-dark); font-weight: 700;">← Quay lại trang chủ</a>
            }
        </p>
    </div>
</div>