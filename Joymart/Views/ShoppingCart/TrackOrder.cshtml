@* =====================================================================
   VIEW: Views/ShoppingCart/TrackOrder.cshtml
   MỤC ĐÍCH:
     Trang Tra cứu đơn hàng dành cho Khách vãng lai (Guest) & Thành viên:
       - Nhập Mã đơn hàng + Số điện thoại nhận hàng để xem tiến trình 4 bước
         (Chờ xử lý -> Đã xác nhận -> Đang giao -> Hoàn thành) và chi tiết đơn.
   ===================================================================== *@
@model Joymart.Models.TrackOrderViewModel
@using System.Linq

@{
    ViewBag.Title = "Tra cứu đơn hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="section-header" style="margin-top: 28px;">
    <h2 class="section-title">Tra cứu trạng thái đơn hàng</h2>
</div>

<!-- FORM NHẬP MÃ ĐƠN & SỐ ĐIỆN THOẠI -->
<div class="catalog-toolbar" style="margin-bottom: 24px;">
    @using (Html.BeginForm("TrackOrder", "ShoppingCart", FormMethod.Get, new { @class = "catalog-search" }))
    {
        <input type="number"
               name="orderId"
               min="1"
               value="@Model.OrderID"
               placeholder="Nhập mã đơn hàng (ví dụ: 1)"
               required />

        <input type="text"
               name="phone"
               maxlength="15"
               value="@Model.Phone"
               placeholder="Nhập số điện thoại nhận hàng (ví dụ: 0901234567)"
               required />

        <button type="submit" class="btn-brand">Tra cứu ngay</button>
    }
</div>

@if (Model.Searched && !string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="cart-message cart-message-error">@Model.ErrorMessage</div>
}

@if (Model.FoundOrder != null)
{
    var order = Model.FoundOrder;
    decimal subTotal = order.OrderDetails.Sum(d => d.Quantity * d.UnitPrice);
    string[] steps = { "Chờ xử lý", "Đã xác nhận", "Đang giao", "Hoàn thành" };
    int currentIdx = System.Array.IndexOf(steps, order.Status);

    if (order.Status == "Đã hủy")
    {
        <div class="cart-message cart-message-error">
            Đơn hàng #@order.OrderID hiện ở trạng thái: <strong>Đã hủy</strong>.
        </div>
    }
    else
    {
        <!-- THANH TIẾN TRÌNH 4 BƯỚC GIAO HÀNG -->
        <div class="order-steps-bar">
            @for (int i = 0; i < steps.Length; i++)
            {
                string stateClass = i < currentIdx ? "done" : (i == currentIdx ? "current" : "");
                <div class="order-step-item @stateClass">
                    Bước @(i + 1): @steps[i]
                </div>
            }
        </div>
    }

    <div class="order-info-grid">
        <div class="order-info-card">
            <h3>Thông tin đơn hàng #@order.OrderID</h3>
            <p><strong>Ngày đặt hàng:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Ngày xuất kho giao hàng:</strong> @(order.ShippedDate.HasValue ? order.ShippedDate.Value.ToString("dd/MM/yyyy") : "Đang chuẩn bị")</p>
            <p><strong>Trạng thái hiện tại:</strong> <span class="product-category-tag" style="margin:0;">@order.Status</span></p>
            <p><strong>Tạm tính tiền hàng:</strong> @subTotal.ToString("#,##0") đ</p>
            <p><strong>Phí vận chuyển:</strong> @(order.ShippingFee == 0 ? "Miễn phí (0 đ)" : order.ShippingFee.ToString("#,##0") + " đ")</p>
            <p><strong>Tổng thanh toán:</strong> <span class="product-price">@order.TotalAmount.ToString("#,##0") đ</span></p>
        </div>

        <div class="order-info-card">
            <h3>Thông tin nhận hàng</h3>
            <p><strong>Người nhận:</strong> @(order.RecipientName ?? (order.Customer != null ? order.Customer.FullName : ""))</p>
            <p><strong>Số điện thoại:</strong> @(order.ShippingPhone ?? (order.Customer != null ? order.Customer.Phone : ""))</p>
            <p><strong>Địa chỉ nhận:</strong> @order.ShippingAddress</p>
        </div>
    </div>

    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in order.OrderDetails)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="~/Content/images/@(string.IsNullOrEmpty(detail.Product.ImageUrl) ? "no-image.png" : detail.Product.ImageUrl)"
                                     alt="@detail.Product.ProductName"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                                <strong>@detail.Product.ProductName</strong>
                            </div>
                        </td>
                        <td>@detail.UnitPrice.ToString("#,##0") đ</td>
                        <td><strong>@detail.Quantity</strong></td>
                        <td class="product-price">@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
