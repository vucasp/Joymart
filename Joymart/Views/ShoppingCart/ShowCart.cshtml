@* =====================================================================
   VIEW: Views/ShoppingCart/ShowCart.cshtml
   MỤC ĐÍCH:
     Hiển thị giỏ hàng từ Session["Cart"], thanh tiến trình đạt mốc
     Miễn phí vận chuyển (360.067đ) và tổng cộng kèm phí vận chuyển.
   ===================================================================== *@
@model Joymart.Models.Cart
@using System.Linq

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    decimal subTotal = Model.TotalMoney();
    decimal shippingFee = Model.ShippingFee();
    decimal needed = Model.AmountNeededForFreeShipping();
    int progress = Model.FreeShippingProgressPercent();
}

<div class="section-header" style="margin-top: 28px;">
    <h2 class="section-title">Giỏ hàng của bạn</h2>
    @if (Model.Items.Any())
    {
        using (Html.BeginForm("ClearCart", "ShoppingCart", FormMethod.Post, new { style = "margin:0;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-danger-soft" onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?');">
                Xóa toàn bộ giỏ hàng
            </button>
        }
    }
</div>

@if (TempData["CartError"] != null)
{
    <div class="cart-message cart-message-error">
        @TempData["CartError"]
    </div>
}

@if (!Model.Items.Any())
{
    <div class="catalog-empty">
        <h3>Giỏ hàng đang trống</h3>
        <p>Bạn chưa thêm sản phẩm nào vào giỏ. Hãy quay lại Trang chủ Joymart để lựa chọn sản phẩm yêu thích.</p>
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Store", null, new { @class = "btn-brand" })
    </div>
}
else
{
    <!-- THANH TIẾN TRÌNH ĐỒNG BỘ CHÍNH SÁCH FREESHIP (360.067Đ) -->
    <div class="freeship-banner">
        <div class="freeship-text">
            @if (needed > 0)
            {
                <span>Mua thêm <strong style="color: #e11d48;">@needed.ToString("#,##0") đ</strong> nữa để được <strong>Miễn phí vận chuyển toàn quốc</strong>!</span>
            }
            else
            {
                <span style="color: #15803d;">Đơn hàng của bạn đã đủ điều kiện <strong>Miễn phí vận chuyển toàn quốc (0 đ)</strong>!</span>
            }
            <span>@progress%</span>
        </div>
        <div class="freeship-progress-track">
            <div class="freeship-progress-fill" style="width: @(progress)%;"></div>
        </div>
    </div>

    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th style="width: 90px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="~/Content/images/@(string.IsNullOrEmpty(item.ImageUrl) ? "no-image.png" : item.ImageUrl)"
                                     alt="@item.ProductName"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                                <div>
                                    <strong>@item.ProductName</strong>
                                    <small>Còn trong kho: @item.StockQuantity sản phẩm</small>
                                </div>
                            </div>
                        </td>
                        <td><strong>@item.UnitPrice.ToString("#,##0") đ</strong></td>
                        <td>
                            @using (Html.BeginForm("UpdateQuantity", "ShoppingCart", FormMethod.Post, new { @class = "qty-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" />
                                <button class="btn-soft" type="submit">Cập nhật</button>
                            }
                        </td>
                        <td class="product-price">@item.LineTotal.ToString("#,##0") đ</td>
                        <td>
                            @using (Html.BeginForm("Remove", "ShoppingCart", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <button class="btn-soft" type="submit" style="color: #e11d48; border-color: #fecdd3;">Xóa</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-summary">
        <div style="display: flex; justify-content: space-between; font-size: 14.5px;">
            <span>Tổng số lượng:</span>
            <strong>@Model.TotalQuantity() sản phẩm</strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 14.5px;">
            <span>Tạm tính tiền hàng:</span>
            <strong>@subTotal.ToString("#,##0") đ</strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 14.5px;">
            <span>Phí vận chuyển dự kiến:</span>
            @if (shippingFee == 0)
            {
                <strong style="color: #15803d;">Miễn phí (0 đ)</strong>
            }
            else
            {
                <strong>@shippingFee.ToString("#,##0") đ</strong>
            }
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 18px; padding-top: 10px; border-top: 1px solid var(--line);">
            <span>Tổng thanh toán:</span>
            <strong class="product-price" style="font-size: 22px;">@Model.GrandTotal().ToString("#,##0") đ</strong>
        </div>

        <div class="cart-summary-actions">
            @Html.ActionLink("Tiếp tục mua hàng", "Index", "Store", null, new { @class = "btn-soft" })
            @if (Session["UserID"] != null)
            {
                <a class="btn-brand" href="@Url.Action("Checkout", "ShoppingCart")">Tiến hành đặt hàng</a>
            }
            else
            {
                <a class="btn-soft" href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Checkout", "ShoppingCart") })">Đăng nhập để đặt</a>
                <a class="btn-brand" href="@Url.Action("Checkout", "ShoppingCart")">Đặt hàng vãng lai</a>
            }
        </div>
    </div>
}
