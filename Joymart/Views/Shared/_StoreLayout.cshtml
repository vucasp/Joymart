@* =====================================================================
   LAYOUT KHÁCH HÀNG: Views/Shared/_StoreLayout.cshtml
   MỤC ĐÍCH:
     Khung giao diện dùng chung cho toàn bộ trang mua sắm phía Khách hàng:
       - Nạp bộ file CSS đã tách theo từng phân hệ trong ~/Content/css/
       - Thanh Topbar chính sách Freeship 360.067đ
       - Thanh Header điều hướng (có Tra cứu đơn hàng & Giỏ hàng Session)
       - Chân trang (Footer) thiết kế mới chia 3 cột cân đối
   ===================================================================== *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Joymart</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/css/base.css?v=2" rel="stylesheet" />
    <link href="~/Content/css/store.css?v=2" rel="stylesheet" />
    <link href="~/Content/css/product-detail.css?v=2" rel="stylesheet" />
    <link href="~/Content/css/cart-checkout.css?v=2" rel="stylesheet" />
    <link href="~/Content/css/auth-member.css?v=2" rel="stylesheet" />
    <link href="~/Content/css/about.css?v=2" rel="stylesheet" />
    @RenderSection("styles", required: false)
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Thanh thông báo chính sách vận chuyển trên cùng -->
    <div class="store-topbar">
        <div class="container">
            <span>Miễn phí vận chuyển toàn quốc cho đơn hàng từ 360.067đ</span>
            <span>Hotline hỗ trợ: 3667 6736</span>
        </div>
    </div>

    <!-- Header: Logo Joymart và Menu điều hướng khách hàng -->
    <header class="store-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index", "Store")">JOY<span>MART</span></a>

            <nav class="store-nav">
                @Html.ActionLink("Trang chủ", "Index", "Store")
                @Html.ActionLink("Giới thiệu", "AboutStore", "Store")
                @Html.ActionLink("Tra cứu đơn", "TrackOrder", "ShoppingCart")

                @{ Html.RenderAction("BagCart", "ShoppingCart"); }

                @if (Session["UserID"] == null)
                {
                    <a href="@Url.Action("SignUp", "Account")">Đăng ký</a>
                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                }
                else
                {
                    if (Convert.ToString(Session["Role"]) == "Admin")
                    {
                        <a class="nav-admin-pill" href="@Url.Action("Index", "Admin")">Trang quản trị</a>
                    }
                    else
                    {
                        <a href="@Url.Action("MyOrders", "Member")">Đơn mua</a>
                    }

                    @* Gộp mục Hồ sơ vào phần "Xin chào, xxx": khi di chuột vào sẽ hiện ra nút chọn Hồ sơ *@
                    <div class="nav-user-dropdown">
                        <span class="nav-user-trigger">
                            Xin chào, @(Session["FullName"] ?? Session["UserName"])
                        </span>
                        <div class="nav-user-menu">
                            @if (Session["CustomerID"] != null)
                            {
                                <a href="@Url.Action("Profile", "Member")" class="nav-user-menu-btn">Hồ sơ</a>
                            }
                            else
                            {
                                <a href="@Url.Action("ChangePassword", "Member")" class="nav-user-menu-btn">Đổi mật khẩu</a>
                            }
                        </div>
                    </div>

                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "nav-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link-button">Đăng xuất</button>
                    }
                }
            </nav>
        </div>
    </header>

    <!-- Vùng nội dung chính của từng trang -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer cửa hàng bố cục 3 cột -->
    <footer class="store-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <div class="footer-brand-title">JOY<span>MART</span></div>
                    <p>
                        Hệ thống thương mại điện tử chuyên cung cấp các dòng sản phẩm phụ kiện, thời trang, đồ gia dụng và thiết bị công nghệ lấy cảm hứng từ thế giới nhân vật Chiikawa.
                    </p>
                </div>

                <div class="footer-col">
                    <h4>Điều hướng nhanh</h4>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Store")">Tất cả sản phẩm</a></li>
                        <li><a href="@Url.Action("AboutStore", "Store")">Giới thiệu &amp; Đội ngũ</a></li>
                        <li><a href="@Url.Action("ShowCart", "ShoppingCart")">Giỏ hàng của bạn</a></li>
                        <li><a href="@Url.Action("TrackOrder", "ShoppingCart")">Tra cứu trạng thái đơn hàng</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Chính sách &amp; Hỗ trợ</h4>
                    <p><strong>Vận chuyển:</strong> Miễn phí giao hàng toàn quốc cho đơn từ 360.067đ (đơn dưới mốc phí tiêu chuẩn 25.000đ).</p>
                    <p><strong>Cam kết:</strong> Tồn kho minh bạch theo thời gian thực, hỗ trợ kiểm tra tình trạng giao nhận trực tuyến.</p>
                    <p><strong>Hotline:</strong> 3667 6736</p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year Joymart — Đồ án học phần Lập Trình Web (HUFLIT)</span>
                <span>Phát triển trên nền tảng ASP.NET MVC 5 &amp; Entity Framework 6</span>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
