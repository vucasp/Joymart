@* ===== LAYOUT DÙNG CHUNG CHO WEBSITE JOYMART ===== *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Joymart</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/joymart.css?v=7" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Thanh thông báo trên cùng -->
    <div class="store-topbar">
        <div class="container">
            <span></span>
            <span>Hotline hỗ trợ: 3667 6736</span>
        </div>
    </div>

    <!-- Header: Logo Joymart và Menu điều hướng -->
    <header class="store-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index", "Store")">JOY<span>MART</span></a>

            <nav class="store-nav">
                @* Menu chung cho tất cả người dùng *@
                @Html.ActionLink("Giới thiệu", "AboutStore", "Store")
                @Html.ActionLink("Trang chủ", "Index", "Store")

                @* Giỏ hàng từ Session*@
                @{ Html.RenderAction("BagCart", "ShoppingCart"); }

                @if (Session["UserID"] == null)
                {
                    @* Trạng thái Guest (chưa đăng nhập) *@
                    <a href="@Url.Action("SignUp", "Account")">Đăng ký</a>
                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                }
                else
                {
                    @* Nếu là Admin đang xem giao diện cửa hàng thì hiện nút chuyển sang Portal Quản trị riêng *@
                    if (Convert.ToString(Session["Role"]) == "Admin")
                    {
                        <a href="@Url.Action("Index", "Admin")" style="background: #ffe4ef; color: #be185d; border: 1px solid #fbcfe8;">Trang quản trị</a>
                    }
                    else
                    {
                        <a href="@Url.Action("MyOrders", "Member")">Đơn mua</a>
                        <a href="@Url.Action("Profile", "Member")">Hồ sơ</a>
                    }

                    <span class="nav-user">
                        Xin chào, @(Session["FullName"] ?? Session["UserName"])
                    </span>

                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "nav-logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link-button">Đăng xuất</button>
                    }
                }
            </nav>
        </div>
    </header>

    <!-- Vùng nội dung chính của từng View -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer dùng chung -->
    <footer class="store-footer">
        <div class="container">
            <strong>JOYMART</strong>
            <p style="margin: 8px 0 0; font-size: 14px; color: #94a3b8;">
                Hệ thống cung cấp các sản phẩm liên quan đến chủ đề Chiikawa
            </p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>