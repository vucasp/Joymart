<!-- ===== PHẦN 3: PHÂN CÔNG CÔNG VIỆC TRONG BÀI LÀM WEB ===== -->
<section class="about-section-block">
    <div class="section-header">
        <h2 class="section-title">Phân công công việc</h2>
        <span style="color: var(--muted); font-size: 14px;">Chi tiết nhiệm vụ từng thành viên</span>
    </div>

    <div class="task-panel">
        <table class="task-table">
            <thead>
                <tr>
                    <th style="width: 22%;">Thành viên</th>
                    <th style="width: 44%;">Nội dung công việc đảm nhận</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Huỳnh Trọng Nghĩa</strong></td>
                    <td>
                        <ul class="task-list-items">
                            <li>Thiết kế kiến trúc tổng thể hệ thống, CSDL DBJoymart, Entity Framework</li>
                            <li>Bảo mật mật khẩu</li>
                            <li>Kiểm thử và hoàn thiện báo cáo</li>
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td><strong>Võ Trần Nguyên Vũ</strong></td>
                    <td>
                        <ul class="task-list-items">
                            <li>Chức năng trang chủ StoreController</li>
                            <li>Quản lý sản phẩm</li>
                            <li>Quản lý danh mục</li>
                            <li>Hệ thống giỏ hàng</li>
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td><strong>Lê Tuấn Vũ</strong></td>
                    <td>
                        <ul class="task-list-items">
                            <li>Thiết kế giao diện CSS, JS, giao diện layout dùng chung</li>
                            <li>Phân hệ tài khoản khách hàng & admin</li>
                            <li>Quản lý đơn hàng</li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="margin-top: 28px;">
        <a class="btn-brand" href="@Url.Action("Index", "Store")">← Quay lại trang mua sắm Joymart</a>
    </div>
</section>