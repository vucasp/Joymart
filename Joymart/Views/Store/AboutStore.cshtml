@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<!-- ===== PHẦN 1: THÔNG TIN TRANG WEB JOYMART ===== -->
<section class="about-card">
    <span class="product-category-tag">VỀ TRANG WEB</span>
    <h2>Joymart — Website mua sắm trực tuyến hiện đại</h2>
    <p>
        <strong>Joymart</strong> là website thương mại điện tử được tạo ra để cung cấp các sản phẩm lấy ý tưởng từ bộ phim hoạt hình Chiikawa đến cho người dùng.
    </p>
    <p>
        Hệ thống cung cấp đa dạng danh mục sản phẩm từ thiết bị công nghệ, thời trang phong cách đến đồ gia dụng và phụ kiện tiện ích với thông tin minh bạch, giá cả rõ ràng và giao diện tương thích trên cả máy tính lẫn điện thoại (Chắc vậy).
    </p>
</section>

