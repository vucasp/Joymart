@* =====================================================================
   VIEW: Views/Store/AboutStore.cshtml
   MỤC ĐÍCH:
     Trang Giới thiệu của Joymart:
       - Hero giới thiệu thương hiệu & các chỉ số vận hành nổi bật
       - Đội ngũ phát triển (bỏ MSSV theo yêu cầu) & Bảng phân công công việc
   ===================================================================== *@
@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<!-- PHẦN 1: HERO GIỚI THIỆU DỰ ÁN JOYMART -->
<section class="about-hero">
    <div>
        <span class="product-category-tag" style="margin-bottom: 6px;">CÂU CHUYỆN THƯƠNG HIỆU</span>
        <h1>Không gian mua sắm chủ đề <span>Chiikawa</span> hiện đại &amp; minh bạch</h1>
        <p>
            <strong>Joymart</strong> là hệ thống thương mại điện tử trực tuyến được xây dựng nhằm mang các dòng sản phẩm lấy cảm hứng từ bộ nhân vật hoạt hình Chiikawa đến gần hơn với người yêu thích sưu tầm.
        </p>
        <p>
            Từ thiết bị công nghệ, trang phục thường ngày cho đến đồ gia dụng và phụ kiện tiện ích, toàn bộ dữ liệu sản phẩm, tồn kho, chính sách vận chuyển và tiến trình giao nhận đều được đồng bộ tự động theo thời gian thực.
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px;">
            <a class="btn-brand" href="@Url.Action("Index", "Store")">Khám phá cửa hàng</a>
            <a class="btn-soft" href="@Url.Action("TrackOrder", "ShoppingCart")">Tra cứu đơn hàng</a>
        </div>
    </div>

    <div class="about-highlights">
        <div class="about-highlight-box">
            <strong>4 Nhóm</strong>
            <span>Ngành hàng chuyên biệt chủ đề Chiikawa</span>
        </div>
        <div class="about-highlight-box">
            <strong>360.067đ</strong>
            <span>Mốc đơn hàng hưởng Miễn phí vận chuyển</span>
        </div>
        <div class="about-highlight-box">
            <strong>100%</strong>
            <span>Đồng bộ tức thời giữa Kho hàng &amp; Cửa hàng</span>
        </div>
        <div class="about-highlight-box">
            <strong>PBKDF2</strong>
            <span>Mã hóa mật khẩu 100.000 vòng lặp an toàn</span>
        </div>
    </div>
</section>

