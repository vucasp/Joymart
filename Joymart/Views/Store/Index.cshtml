@* =====================================================================
   VIEW: Views/Store/Index.cshtml
   MỤC ĐÍCH:
     Trang chủ cửa hàng Joymart:
       - Slideshow Banner Chiikawa
       - Thanh tìm kiếm từ khóa, lọc khoảng giá & sắp xếp
       - Sidebar danh mục + Lưới sản phẩm có gắn nhãn tồn kho trực quan (Text Badge)
   ===================================================================== *@
@model Joymart.Models.StoreHomeViewModel

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

@if (TempData["CartError"] != null)
{
    <div class="cart-message cart-message-error" style="margin-top: 20px;">
        @TempData["CartError"]
    </div>
}
@if (TempData["MemberError"] != null)
{
    <div class="cart-message cart-message-error" style="margin-top: 20px;">
        @TempData["MemberError"]
    </div>
}

<!-- SLIDESHOW BANNER -->
<div class="slideshow-container">
    <div class="mySlides fade">
        <div class="numbertext">1 / 3</div>
        <img src="~/Content/images/banner/chiikawa-banner-1.jpg" alt="Chiikawa Collection" />
        <div class="text">KHÁM PHÁ CÁC SẢN PHẨM DỰA TRÊN CÁC SINH VẬT ĐÁNG YÊU</div>
    </div>

    <div class="mySlides fade">
        <div class="numbertext">2 / 3</div>
        <img src="~/Content/images/banner/chiikawa-banner-2.jpg" alt="Hachiware Edition" />
        <div class="text">LIÊN TỤC CẬP NHẬT CÁC PHIÊN BẢN SẢN PHẨM MỚI NHẤT</div>
    </div>

    <div class="mySlides fade">
        <div class="numbertext">3 / 3</div>
        <img src="~/Content/images/banner/chiikawa-banner-3.jpg" alt="Usagi Collection" />
        <div class="text">ĐA DẠNG MẪU MÃ ĐỂ NGƯỜI DÙNG TỰ DO LỰA CHỌN</div>
    </div>

    <a class="prev" onclick="plusSlides(-1)">&lt;</a>
    <a class="next" onclick="plusSlides(1)">&gt;</a>
</div>
<br />

<div style="text-align:center">
    <span class="dot" onclick="currentSlide(1)"></span>
    <span class="dot" onclick="currentSlide(2)"></span>
    <span class="dot" onclick="currentSlide(3)"></span>
</div>

<!-- THANH TÌM KIẾM, LỌC GIÁ & SẮP XẾP -->
<div class="catalog-toolbar" id="featured-products" style="margin-top: 18px;">
    @using (Html.BeginForm("Index", "Store", FormMethod.Get, new { @class = "catalog-search" }))
    {
        if (Model.SelectedCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
        }

        <input type="text"
               name="keyword"
               value="@Model.SearchTerm"
               placeholder="Tìm tên hoặc mô tả sản phẩm..." />

        <input type="number"
               name="minPrice"
               value="@Model.MinPrice"
               min="0"
               step="1000"
               placeholder="Giá từ (đ)" />

        <input type="number"
               name="maxPrice"
               value="@Model.MaxPrice"
               min="0"
               step="1000"
               placeholder="Giá đến (đ)" />

        <select name="sortOrder">
            <option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Sắp xếp: Mới nhất</option>
            <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá thấp đến cao</option>
            <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá cao đến thấp</option>
        </select>

        <button type="submit" class="btn-brand">Tìm kiếm</button>
        <a class="btn-soft" href="@Url.Action("Index", "Store")">Xóa lọc</a>
    }
</div>

<div class="section-header">
    <h2 class="section-title">Danh mục sản phẩm</h2>
    <span style="color: var(--muted); font-size: 14.5px; font-weight: 600;">
        Tìm thấy <strong style="color: var(--brand-dark);">@Model.TotalItems</strong> sản phẩm
    </span>
</div>

<!-- KHUNG CHÍNH: DANH MỤC ĐỘNG TRÁI + LƯỚI SẢN PHẨM PHẢI -->
<div class="store-shell">
    <aside class="category-panel">
        <h3>Nhóm ngành hàng</h3>
        <ul class="category-list">
            <li>
                <a class="@(Model.SelectedCategoryId == null ? "active" : "")"
                   href="@Url.Action("Index", "Store", new {
                       keyword = Model.SearchTerm,
                       minPrice = Model.MinPrice,
                       maxPrice = Model.MaxPrice,
                       sortOrder = Model.SortOrder
                   })">
                    Tất cả sản phẩm
                </a>
            </li>
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a class="@(Model.SelectedCategoryId == category.CategoryID ? "active" : "")"
                       href="@Url.Action("Index", "Store", new {
                           categoryId = category.CategoryID,
                           keyword = Model.SearchTerm,
                           minPrice = Model.MinPrice,
                           maxPrice = Model.MaxPrice,
                           sortOrder = Model.SortOrder
                       })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section>
        @if (Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var item in Model.Products)
                {
                    <article class="product-card">
                        <div class="product-image">
                            <img src="~/Content/images/@(string.IsNullOrEmpty(item.ImagePro) ? "no-image.png" : item.ImagePro)"
                                 alt="@item.NamePro"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                        </div>

                        <div class="product-body">
                            <span class="product-category-tag">@item.CategoryName</span>
                            <div class="product-name">@item.NamePro</div>
                            <div class="product-description">@item.ShortDescription</div>

                            <div class="product-price-row">
                                <div class="product-price">@item.Price.ToString("#,##0") đ</div>
                                @if (item.StockQuantity <= 0)
                                {
                                    <span class="status-badge status-inactive">Hết hàng</span>
                                }
                                else if (item.StockQuantity <= 5)
                                {
                                    <span class="status-badge status-warning">Sắp hết</span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">Còn hàng</span>
                                }
                            </div>

                            <div class="product-actions">
                                @Html.ActionLink("Chi tiết", "Details", "Products", new { id = item.ProductID }, new { @class = "btn-soft" })

                                @if (item.StockQuantity > 0)
                                {
                                    @Html.ActionLink("Mua ngay", "AddToCart", "ShoppingCart", new { id = item.ProductID, mode = "buy" }, new { @class = "btn-brand" })
                                }
                                else
                                {
                                    <span class="btn-disabled">Hết hàng</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>Không có sản phẩm nào khớp với từ khóa, danh mục hoặc khoảng giá bạn đang chọn.</p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">Xem tất cả sản phẩm</a>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="store-pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "Store", new {
                        categoryId = Model.SelectedCategoryId,
                        keyword = Model.SearchTerm,
                        minPrice = Model.MinPrice,
                        maxPrice = Model.MaxPrice,
                        sortOrder = Model.SortOrder,
                        page = Model.CurrentPage - 1
                    })">Trước</a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Store", new {
                            categoryId = Model.SelectedCategoryId,
                            keyword = Model.SearchTerm,
                            minPrice = Model.MinPrice,
                            maxPrice = Model.MaxPrice,
                            sortOrder = Model.SortOrder,
                            page = i
                        })">@i</a>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "Store", new {
                        categoryId = Model.SelectedCategoryId,
                        keyword = Model.SearchTerm,
                        minPrice = Model.MinPrice,
                        maxPrice = Model.MaxPrice,
                        sortOrder = Model.SortOrder,
                        page = Model.CurrentPage + 1
                    })">Sau</a>
                }
            </div>
        }
    </section>
</div>

@section scripts {
    <script src="~/Scripts/chiikawa-slider.js?v=2"></script>
}
