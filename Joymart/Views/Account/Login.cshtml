@* =====================================================================
   VIEW: Views/Account/Login.cshtml
   MỤC ĐÍCH:
     Trang Đăng nhập:
       - Toàn bộ phần tiêu đề phía trên được căn giữa (auth-card-header).
       - Từ phần Tên đăng nhập trở xuống giữ căn lề trái chuẩn form nhập liệu.
   ===================================================================== *@
@model Joymart.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <!-- Phần tiêu đề phía trên căn giữa toàn bộ -->
        <div class="auth-card-header">
            <span class="product-category-tag" style="align-self: center;">XIN CHÀO</span>
            <h2>Đăng nhập Joymart</h2>
            <p class="auth-subtitle">Đăng nhập bằng tài khoản thành viên hoặc quản trị viên của bạn.</p>
        </div>

        @if (TempData["SignUpSuccess"] != null)
        {
            <div class="cart-message cart-message-success" style="text-align: center;">
                @TempData["SignUpSuccess"]
            </div>
        }

        @if (TempData["LoginRequired"] != null)
        {
            <div class="cart-message cart-message-error" style="text-align: center;">
                @TempData["LoginRequired"]
            </div>
        }

        <!-- Từ phần Tên đăng nhập trở xuống căn lề trái -->
        <div class="auth-form-body">
            @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

                <div class="auth-field">
                    @Html.LabelFor(m => m.UserName)
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control-modern", placeholder = "Nhập tên đăng nhập" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                </div>

                <div class="auth-field">
                    @Html.LabelFor(m => m.Password)
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control-modern", placeholder = "Nhập mật khẩu" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-brand auth-submit">Đăng nhập</button>
            }

            <p class="auth-bottom-link" style="text-align: left;">
                Chưa có tài khoản?
                <a href="@Url.Action("SignUp", "Account")" style="color: var(--brand-dark); font-weight: 700;">Đăng ký thành viên</a>
            </p>
        </div>
    </div>
</div>
