@* =====================================================================
   VIEW: Views/Categories/Create.cshtml
   MỤC ĐÍCH:
     Form tạo danh mục ngành hàng mới theo bố cục Card hiện đại của Admin Portal.
   ===================================================================== *@
@model Joymart.Models.Category

@{
    ViewBag.Title = "Thêm danh mục mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-panel" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-toolbar">
        <h2 class="section-title">Tạo danh mục ngành hàng mới</h2>
        @Html.ActionLink("← Quay lại danh sách", "Index", null, new { @class = "btn-soft" })
    </div>

    @using (Html.BeginForm("Create", "Categories", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

        <div class="auth-field">
            <label for="CategoryName">Tên danh mục sản phẩm</label>
            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control-modern", placeholder = "Ví dụ: Văn phòng phẩm Chiikawa", maxlength = "100" })
            @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
        </div>

        <div style="display: flex; gap: 12px; margin-top: 22px;">
            <button type="submit" class="btn-brand">Lưu danh mục mới</button>
            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn-soft" })
        </div>
    }
</div>
