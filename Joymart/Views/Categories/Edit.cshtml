@* =====================================================================
   VIEW: Views/Categories/Edit.cshtml
   MỤC ĐÍCH:
     Form chỉnh sửa tên danh mục ngành hàng theo bố cục Card hiện đại.
   ===================================================================== *@
@model Joymart.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-panel" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-toolbar">
        <div>
            <h2 class="section-title">Cập nhật danh mục #@Model.CategoryID</h2>
            <small style="color: #64748b; display: block; margin-top: 4px;">
                Thay đổi tên danh mục sẽ tự động cập nhật trên toàn bộ sản phẩm trực thuộc.
            </small>
        </div>
        @Html.ActionLink("← Quay lại", "Index", null, new { @class = "btn-soft" })
    </div>

    @using (Html.BeginForm("Edit", "Categories", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CategoryID)
        @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

        <div class="auth-field">
            <label for="CategoryName">Tên danh mục</label>
            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control-modern", placeholder = "Nhập tên danh mục", maxlength = "100" })
            @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
        </div>

        <div style="display: flex; gap: 12px; margin-top: 22px;">
            <button type="submit" class="btn-brand">Lưu thay đổi</button>
            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn-soft" })
        </div>
    }
</div>
