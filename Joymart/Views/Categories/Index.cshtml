@* =====================================================================
   VIEW: Views/Categories/Index.cshtml
   MỤC ĐÍCH:
     Giao diện Quản lý danh mục thiết kế mới:
       - Thẻ thống kê tổng quan danh mục & sản phẩm phân loại
       - Thanh tìm kiếm nhanh theo tên danh mục
       - Bảng danh mục hiện đại kèm số sản phẩm đang bán, tổng tồn kho và cụm nút thao tác
   ===================================================================== *@
@model IEnumerable<Joymart.Models.Category>
@using System.Linq

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- THẺ THỐNG KÊ DANH MỤC -->
<div class="admin-kpi-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
    <div class="admin-kpi-card">
        <span class="admin-kpi-label">Tổng nhóm danh mục</span>
        <div class="admin-kpi-value">@ViewBag.TotalCategories</div>
        <span class="admin-kpi-sub">Đang hiển thị trên thanh lọc cửa hàng</span>
    </div>

    <div class="admin-kpi-card">
        <span class="admin-kpi-label">Sản phẩm đã phân loại</span>
        <div class="admin-kpi-value" style="color: #0284c7;">@ViewBag.TotalAssignedProducts</div>
        <span class="admin-kpi-sub">Thuộc các nhóm ngành hàng hiện có</span>
    </div>

    <div class="admin-kpi-card">
        <span class="admin-kpi-label">Danh mục trống</span>
        <div class="admin-kpi-value" style="color: #64748b;">@ViewBag.EmptyCategories</div>
        <span class="admin-kpi-sub">Chưa gắn mặt hàng nào (có thể xóa)</span>
    </div>
</div>

<div class="admin-panel">
    <div class="admin-toolbar">
        <div>
            <h2 class="section-title">Danh sách nhóm ngành hàng (@Model.Count())</h2>
            <small style="color: #64748b; display: block; margin-top: 4px;">
                Phân loại rõ ràng giúp khách hàng lọc sản phẩm nhanh hơn trên trang chủ.
            </small>
        </div>
        @Html.ActionLink("+ Thêm danh mục mới", "Create", null, new { @class = "btn-brand" })
    </div>

    @if (TempData["CategorySuccess"] != null)
    {
        <div class="cart-message cart-message-success">@TempData["CategorySuccess"]</div>
    }
    @if (TempData["CategoryError"] != null)
    {
        <div class="cart-message cart-message-error">@TempData["CategoryError"]</div>
    }

    <!-- THANH TÌM KIẾM DANH MỤC -->
    <div class="catalog-toolbar" style="background: #f8fafc; border-color: #e2e8f0; margin-bottom: 20px;">
        @using (Html.BeginForm("Index", "Categories", FormMethod.Get, new { @class = "catalog-search" }))
        {
            <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm kiếm theo tên danh mục..." />
            <button type="submit" class="btn-brand">Tìm danh mục</button>
            <a class="btn-soft" href="@Url.Action("Index", "Categories")">Đặt lại</a>
        }
    </div>

    <div style="overflow-x: auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 110px;">Mã DM</th>
                    <th>Tên danh mục ngành hàng</th>
                    <th>Số mặt hàng</th>
                    <th>Tổng lượng tồn kho</th>
                    <th style="width: 260px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int prodCount = item.Products != null ? item.Products.Count : 0;
                    int activeCount = item.Products != null ? item.Products.Count(p => p.IsActive) : 0;
                    int totalStock = item.Products != null ? item.Products.Sum(p => p.StockQuantity) : 0;

                    <tr>
                        <td><strong>#@item.CategoryID</strong></td>
                        <td>
                            <strong style="font-size: 15px; color: #0f172a;">@item.CategoryName</strong>
                            <div style="font-size: 12.5px; color: #64748b; margin-top: 2px;">
                                Đang kinh doanh: @activeCount / @prodCount sản phẩm
                            </div>
                        </td>
                        <td>
                            @if (prodCount > 0)
                            {
                                <span class="product-category-tag" style="margin: 0;">@prodCount sản phẩm</span>
                            }
                            else
                            {
                                <span class="status-badge" style="background: #f1f5f9; color: #64748b;">Chưa có sản phẩm</span>
                            }
                        </td>
                        <td><strong>@totalStock</strong> đơn vị</td>
                        <td style="white-space: nowrap;">
                            <div style="display: inline-flex; gap: 6px; align-items: center;">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn-soft", style = "padding: 6px 12px; font-size: 12.5px;" })
                                @Html.ActionLink("Chỉnh sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn-brand", style = "padding: 6px 12px; font-size: 12.5px;" })
                                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn-soft", style = "padding: 6px 12px; font-size: 12.5px; color: #e11d48; border-color: #fecdd3;" })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
