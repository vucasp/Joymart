@{
    ViewBag.Title = "Không có quyền truy cập (403)";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-card" style="text-align: center; max-width: 520px;">
        <div style="font-size: 56px; font-weight: 900; color: #e11d48; line-height: 1;">403</div>
        <h2 style="margin-top: 12px;">Không có quyền truy cập</h2>
        <p class="auth-subtitle">
            Tài khoản của bạn không có quyền quản trị viên để truy cập khu vực này.
        </p>
        <div style="display: flex; justify-content: center; gap: 12px; margin-top: 20px;">
            @Html.ActionLink("Về trang chủ Joymart", "Index", "Store", null, new { @class = "btn-brand" })
        </div>
    </div>
</div>