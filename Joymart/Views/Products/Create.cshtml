@* =====================================================================
   VIEW: Views/Products/Create.cshtml
   MỤC ĐÍCH:
     Trang Thêm sản phẩm mới cho Admin (sử dụng hàm previewProductImage
     từ Scripts/admin.js để xem trước ảnh tải lên).
   ===================================================================== *@
@model Joymart.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-panel" style="max-width: 820px; margin: 0 auto;">
    <div class="admin-toolbar">
        <h2 class="section-title">Thêm sản phẩm mới</h2>
        @Html.ActionLink("← Quay lại danh sách", "Index", null, new { @class = "btn-soft" })
    </div>

    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "cart-message cart-message-error" })

        <div class="auth-field">
            @Html.LabelFor(model => model.ProductName, "Tên sản phẩm")
            @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control-modern", placeholder = "Ví dụ: Gấu bông Chiikawa phiên bản mới" })
            @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="auth-field">
                @Html.LabelFor(model => model.CategoryID, "Danh mục")
                @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control-modern" })
                @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
            </div>

            <div class="auth-field">
                @Html.LabelFor(model => model.Price, "Đơn giá bán (đ)")
                @Html.TextBoxFor(model => model.Price, new { @class = "form-control-modern", type = "number", min = "0", step = "1000", placeholder = "Ví dụ: 120000" })
                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="auth-field">
            @Html.LabelFor(model => model.StockQuantity, "Số lượng nhập kho ban đầu")
            @Html.TextBoxFor(model => model.StockQuantity, new { @class = "form-control-modern", type = "number", min = "0", placeholder = "Ví dụ: 20" })
            @Html.ValidationMessageFor(model => model.StockQuantity, "", new { @class = "text-danger" })
        </div>

        <div class="auth-field">
            @Html.LabelFor(model => model.Description, "Mô tả sản phẩm")
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control-modern", rows = 3, placeholder = "Mô tả ngắn gọn về chất liệu, kích thước, công dụng..." })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>

        <div class="auth-field">
            <label>Hình ảnh sản phẩm (.jpg, .jpeg, .png — tối đa 2 MB)</label>
            <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <input type="file"
                       id="imageFile"
                       name="ImageFile"
                       class="form-control-modern"
                       style="max-width: 360px;"
                       accept=".jpg,.jpeg,.png"
                       onchange="previewProductImage(this, 'imagePreview')" />
                <img id="imagePreview"
                     alt="Ảnh xem trước"
                     style="display: none; width: 110px; height: 110px; object-fit: cover; border-radius: 12px; border: 1px solid #cbd5e1;" />
            </div>
            <small style="color: #64748b; display: block; margin-top: 6px;">
                Nếu bạn chọn file ảnh đã có sẵn trong <code>Content/images/products</code>, hệ thống sẽ tự động nhận diện và dùng lại ảnh cũ, không tạo bản sao mới.
            </small>
        </div>

        <div class="auth-field">
            <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
                @Html.CheckBoxFor(model => model.IsActive)
                <span>Đang kinh doanh (hiển thị ngay trên cửa hàng)</span>
            </label>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 22px;">
            <input type="submit" value="Lưu sản phẩm" class="btn-brand" />
            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn-soft" })
        </div>
    }
</div>
