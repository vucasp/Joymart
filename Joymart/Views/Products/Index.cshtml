@model IEnumerable<Joymart.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 class="section-title">Quản lý sản phẩm</h2>
        @Html.ActionLink("+ Thêm sản phẩm mới", "Create", null, new { @class = "btn-brand" })
    </div>

    <div style="overflow-x: auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Đơn giá</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="width: 96px;">
                            <img src="~/Content/images/@(string.IsNullOrEmpty(item.ImageUrl) ? "no-image.png" : item.ImageUrl)"
                                 alt="@item.ProductName"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';"
                                 style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid var(--line);" />
                        </td>
                        <td>
                            <strong style="color: var(--ink);">@item.ProductName</strong>
                            <div style="color: var(--muted); font-size: 13px; margin-top: 3px;">@item.Description</div>
                        </td>
                        <td>
                            <span class="product-category-tag" style="margin: 0;">@item.Category.CategoryName</span>
                        </td>
                        <td>
                            <strong style="color: #e11d48;">@item.Price.ToString("#,##0") đ</strong>
                        </td>
                        <td><strong>@item.StockQuantity</strong></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-badge status-active">Đang bán</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Ngừng bán</span>
                            }
                        </td>
                        <td class="action-links" style="white-space: nowrap;">
                            @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }) |
                            @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }) |
                            @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>