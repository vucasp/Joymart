@model Joymart.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="shopee-container">
    <nav class="shopee-breadcrumb">
        <a href="@Url.Action("Index", "Products")">Quản lý sản phẩm</a>
        <span>&gt;</span>
        <span class="current">Xóa sản phẩm #@Model.ProductID</span>
    </nav>

    <div class="shopee-product-box">
        @* CỘT TRÁI: HÌNH ẢNH SẢN PHẨM *@
        <div class="shopee-gallery">
            <div class="shopee-main-img">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="~/Content/images/@Model.ImageUrl" alt="@Model.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/no-image.png")';" />
                }
                else
                {
                    <div class="shopee-no-img">Chưa có hình ảnh</div>
                }
            </div>
        </div>

        @* CỘT PHẢI: CẢNH BÁO & THÔNG TIN SẢN PHẨM CẦN XÓA *@
        <div class="shopee-info">
            <div class="cart-message cart-message-error" style="margin-bottom: 16px;">
                <strong>Cảnh báo: Bạn có chắc chắn muốn xóa sản phẩm này không?</strong> Thao tác này không thể hoàn tác.
            </div>

            <div class="shopee-title-row">
                <h1>@Model.ProductName</h1>
            </div>

            <div class="shopee-stats-row">
                <div class="stat-item">
                    Danh mục: <strong>@(Model.Category != null ? Model.Category.CategoryName : "Không có")</strong>
                </div>
                <span class="stat-divider">|</span>
                <div class="stat-item">
                    Trạng thái:
                    <strong style="color: @(Model.IsActive ? "#15803d" : "#b91c1c");">
                        @(Model.IsActive ? "Đang bán" : "Ngừng bán")
                    </strong>
                </div>
            </div>

            <div class="shopee-price-box">
                <span class="shopee-price-current">@Model.Price.ToString("#,##0") ₫</span>
            </div>

            <div class="shopee-meta-list">
                <div class="shopee-meta-row">
                    <div class="meta-label">Mô tả</div>
                    <div class="meta-value meta-desc">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả." : Model.Description)
                    </div>
                </div>

                <div class="shopee-meta-row">
                    <div class="meta-label">Số lượng tồn kho</div>
                    <div class="meta-value">
                        <strong>@Model.StockQuantity</strong> sản phẩm
                    </div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="shopee-actions">
                    <button type="submit" class="btn-shopee-danger">Xác nhận xóa</button>
                    @Html.ActionLink("Quay lại danh sách", "Index", "Products", null, new { @class = "btn-soft", style = "padding: 13px 22px;" })
                </div>
            }
        </div>
    </div>
</div>